# Strix 环境配置文件
# 复制此文件为 .env 并填写您的 API 密钥

# LLM 配置 (必填)
STRIX_LLM=openai/gpt-4o
LLM_API_KEY=your-api-key-here
# LLM_API_BASE=https://api.openai.com/v1  # 可选，使用自定义 API 端点

# Perplexity API (可选，用于增强搜索能力)
# PERPLEXITY_API_KEY=your-perplexity-key

# 浏览器截图配置
AGENT_BROWSER_SCREENSHOT_DIR=/workspace/screenshots

# 时区配置
TZ=Asia/Shanghai
